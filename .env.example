# LLM Engine Configuration ("gemini" or "ollama")
MODEL_PROVIDER=gemini

# Google Gemini API Settings (Free tier from Google AI Studio)
# Leave blank to use built-in offline simulation mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama Local Edge Model Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Integration Credentials (Optional - Mock fallbacks are provided)
GITHUB_TOKEN=
GITHUB_REPO=octocat/hello-world
SLACK_BOT_TOKEN=
DATABASE_URL=
